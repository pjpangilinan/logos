# ==========================================
# logos - API Keys Configuration
# ==========================================
# Required for running local ingestion scripts or scheduled GitHub Actions.
# The frontend client NEVER reads these keys — all data is queried from data/aggregator.db.

# The Movie Database (TMDB) API Key (Free)
# Sign up at https://www.themoviedb.org/signup and request an API key at https://www.themoviedb.org/settings/api
# Supports both standard v3 API Key (32 hex characters) and v4 Read Access Bearer token
TMDB_API_KEY=your_tmdb_api_key_here

# RAWG Video Games Database API Key (Free)
# Sign up at https://rawg.io/signup and get your free key at https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here
